# Adaptive AI Mock Interview System - Backend Environment
PROJECT_NAME="Adaptive AI Mock Interview System"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite asynchronous database (zero installation needed)
DATABASE_URL="sqlite+aiosqlite:///./interview_app.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mock_interview_db"

# LLM & AI Providers
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# NLP Model Configuration
NLP_MODEL_DIR="./nlp_service/model_registry"
CONFIDENCE_THRESHOLD=0.65

# Media Limits
MAX_RESUME_SIZE_MB=5
MAX_AUDIO_SIZE_MB=25
MEDIA_DIR="./media"
